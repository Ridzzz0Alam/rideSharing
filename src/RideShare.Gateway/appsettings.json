{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Services": {
    "location-service": { "http": [ "http://localhost:8082" ] },
    "ride-service": { "http": [ "http://localhost:8083" ] }
  },
  "ReverseProxy": {
    "Routes": {
      "locations": {
        "ClusterId": "location-service",
        "Match": { "Path": "/api/v1/locations/{**catch-all}" }
      },
      "rides": {
        "ClusterId": "ride-service",
        "Match": { "Path": "/api/v1/rides/{**catch-all}" }
      },
      "ride-hub": {
        "ClusterId": "ride-service",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "location-service": {
        "Destinations": {
          "primary": { "Address": "https+http://location-service" }
        }
      },
      "ride-service": {
        "Destinations": {
          "primary": { "Address": "https+http://ride-service" }
        }
      }
    }
  }
}
